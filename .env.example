# --- Browser -> Next.js ---
# Leave empty to use the built-in proxy (/api/*, /staff/*). Recommended: the backend
# session is an HttpOnly cookie that only works same-origin.
NEXT_PUBLIC_API_BASE_URL=
# Chat WebSocket, full URL, no query string. Route is not in the OpenAPI spec.
NEXT_PUBLIC_WS_URL=

# --- Next.js server -> backend (proxy target) ---
BACKEND_API_URL=https://stag-api.shopsafeng.com

# --- Dev only ---
# NEXT_PUBLIC_DEV_AUTH_BYPASS=false
# NEXT_PUBLIC_DEV_USER_ROLE=customer
